# Telegram Bot
# 1. Message @BotFather on Telegram, send /newbot
# 2. Copy the token you receive
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 3. Message your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Copy the chat.id from the response
TELEGRAM_CHAT_ID=123456789

# GitHub token for storing menu data in the repo
# Create at: https://github.com/settings/tokens/new
# Required scope: repo (Full control of private repositories)
GITHUB_TOKEN=ghp_your_token_here

# PDF URLs for automatic menu fetching (optional - has defaults)
LUNCH_PDF_URL=https://www.ambitescola.cat/_menus/ArturMartorell-Basal.pdf
DINNER_PDF_URL=https://www.ambitescola.cat/_menus/ArturMartorell-Sopars.pdf

# Required for scheduled endpoints. Missing/blank values disable cron operations.
# Vercel sends Authorization: Bearer <CRON_SECRET> for scheduled requests.
CRON_SECRET=

# Required for manual PDF preview/save and Telegram sends. Keep distinct from CRON_SECRET.
# Generate a random value (e.g. openssl rand -hex 32) and set it in .env.local / Vercel.
# Never use NEXT_PUBLIC_OWNER_SECRET. Missing/blank values disable manual operations.
OWNER_SECRET=
